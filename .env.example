# Volume spike threshold (e.g. 3.0 = 300% of average)
VOLUME_SPIKE_THRESHOLD=3.0
LOOKBACK_DAYS=20

# Watchlist: file | russell2000 | sp500 | both (Russell 2000 + S&P 500)
WATCHLIST_SOURCE=russell2000

# Scan interval in minutes (for scheduler)
SCAN_INTERVAL_MINUTES=60

# Gmail notifications (recommended)
GMAIL_ADDRESS=tvoj.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_TO=tvoj.email@gmail.com
GMAIL_MIN_SCORE=80
GMAIL_MIN_TIER=A
GMAIL_COOLDOWN_HOURS=24

# Advanced analysis filters
REGIME_FILTER=true
FILTER_EXTENDED=true
MAX_MA20_EXTENSION_PCT=5.0
MIN_RELATIVE_STRENGTH_PCT=0.0
EARNINGS_WARN_DAYS=2
ENABLE_SENTIMENT=true
BACKTEST_MAX_TICKERS=500

# Telegram notifications (optional)
# 1) Vytvor bota cez @BotFather -> /newbot -> skopiruj token
# 2) Napís botovi správu, potom zisti chat ID cez getUpdates (pozri README alebo docs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional: Alpha Vantage API key for richer data
ALPHA_VANTAGE_API_KEY=